generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  uid                 String    @unique
  name                String
  email               String
  dateCreated         DateTime  @default(now()) // legacy — backfilled into createdAt, drop later
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  discordAccessToken  String?
  discordRefreshToken String?
}

model Reminder {
  id          Int         @id @default(autoincrement())
  uid         String
  message     String
  cronString  String
  guildId     String?
  channelId   String
  channelType ChannelType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@index([uid])
}

model Playlist {
  id          Int      @id @default(autoincrement())
  userId      String
  guildId     String
  tracks      Json
  dateCreated DateTime @default(now()) // legacy — backfilled into createdAt, drop later
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String
  isPrivate   Boolean?

  @@unique([userId, name])
  @@index([userId])
}

model Tag {
  id          Int       @id @default(autoincrement())
  userId      String
  guildId     String?
  name        String
  dateCreated DateTime  @default(now()) // legacy — backfilled into createdAt, drop later
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  message     String
  isMedia     Boolean
  isGuild     Boolean

  @@index([userId, isGuild])
  @@index([guildId, isGuild])
}

model JoinToCreateVC {
  id              Int      @id @default(autoincrement())
  guildId         String   @unique
  parentChannelId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model EphemeralVC {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([guildId, channelId])
}

model PlayerSession {
  guildId        String   @id
  sessionId      String?
  connectionData String
  playerData     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model DiscordSlashCommandIdMapping {
  id          String   @id @default(uuid())
  botId       String
  commandName String
  idHints     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

enum ChannelType {
  DM
  CHANNEL
}
