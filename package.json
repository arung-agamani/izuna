{
    "name": "izuna",
    "version": "0.0.1",
    "description": "Nin Nin!",
    "type": "module",
    "main": "build/index.js",
    "license": "MIT",
    "scripts": {
        "build": "prisma generate && tsc --noEmit && node scripts/build.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "start": "npx prisma migrate deploy && node build/index.js",
        "dev": "tsx watch -r dotenv/config src/index.ts",
        "dev:bot": "cross-env RUN_WEB=0 tsx watch -r dotenv/config src/index.ts",
        "dev:web": "cross-env RUN_BOT=0 tsx watch -r dotenv/config src/index.ts",
        "dev:mute": "cross-env MUTE=1 tsx watch -r dotenv/config src/index.ts",
        "test": "vitest run",
        "test:types": "tsc -p tsconfig.test.json",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.521.0",
        "@fastify/cookie": "^7.3.1",
        "@fastify/cors": "^8.1.0",
        "@fastify/jwt": "^8.0.1",
        "@fastify/oauth2": "7.0.1",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/routes": "^5.0.0",
        "@fastify/session": "^9.0.0",
        "@fastify/swagger": "^7.3.0",
        "@google-cloud/local-auth": "^2.1.1",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@sapphire/discord-utilities": "^2.11.6",
        "@sapphire/discord.js-utilities": "^6.0.4",
        "@sapphire/framework": "^5.5.0",
        "@sentry/node": "^8.55.2",
        "axios": "^0.27.2",
        "cheerio": "^1.0.0-rc.12",
        "cron": "^2.1.0",
        "cross-env": "^7.0.3",
        "date-fns": "^2.28.0",
        "date-fns-tz": "^2.0.0",
        "discord-oauth2": "^2.10.0",
        "discord.js": "^14.26.4",
        "discord.js-pagination": "^1.0.3",
        "dotenv": "^16.0.1",
        "fastify": "^4.0.0",
        "fastify-plugin": "^3.0.1",
        "install": "^0.13.0",
        "lodash.debounce": "^4.0.8",
        "mime-types": "^2.1.35",
        "prisma": "^7.9.1",
        "prom-client": "^15.1.3",
        "serializr": "^3.0.2",
        "shoukaku": "^4.3.0",
        "undici": "5",
        "winston": "^3.19.0",
        "winston-loki": "^6.1.6",
        "ws": "^8.21.0",
        "youtube-search-api": "^1.2.1",
        "zod": "^3.21.4"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@tsconfig/node16": "^1.0.3",
        "@tsconfig/node16-strictest-esm": "^1.0.1",
        "@types/cron": "^2.0.0",
        "@types/lodash.debounce": "^4.0.7",
        "@types/mime-types": "^2.1.4",
        "@types/node": "^22.0.0",
        "autoprefixer": "^10.4.8",
        "esbuild": "^0.28.0",
        "eslint": "^10",
        "globals": "^17",
        "logform": "^2.7.0",
        "nodemon": "^2.0.22",
        "postcss": "^8.4.16",
        "tailwindcss": "^3.1.8",
        "ts-node": "^10.9.1",
        "tsx": "^4.23.11",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8",
        "typescript-language-server": "^5.3.0",
        "vitest": "^4.1.10",
        "vscode-langservers-extracted": "^4",
        "winston-transport": "^4.9.0"
    },
    "resolutions": {
        "logform": "^2.7.0",
        "winston-transport": "^4.9.0"
    }
}
